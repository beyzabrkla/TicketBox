@model List<TicketBox.Application.Features.Categories.Results.GetCategoryQueryResult>
@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Kategori Yönetimi";
}

<div class="max-w-container-max mx-auto">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-lg mb-xl">
        <div>
            <h1 class="font-display-sm text-display-sm text-on-surface tracking-tight">Kategori Yönetimi</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Sistemdeki tüm etkinlik kategorilerini görüntüleyin ve düzenleyin.</p>
        </div>
        <button type="button"
                onclick="openModal(false)"
                class="flex items-center gap-sm bg-primary text-on-primary px-xl py-3 rounded-xl font-label-md text-label-md shadow-lg hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0 transition-all">
            <span class="material-symbols-outlined">add</span>
            Yeni Kategori Ekle
        </button>
    </div>

    <!-- Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-lg">
        @foreach (var item in Model)
        {
            <div class="bg-white rounded-xl shadow-ambient border border-outline-variant/30 hover:border-primary transition-all group overflow-hidden">
                <!-- Görsel Alanı -->
                <div class="h-32 w-full overflow-hidden">
                    <img src="@item.IconUrl" alt="@item.CategoryName" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>

                <!-- İçerik Alanı -->
                <div class="p-lg">
                    <div class="flex justify-between items-start mb-md">
                        <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                            <span class="material-symbols-outlined">@item.IconName</span>
                        </div>
                        <div class="flex gap-xs opacity-0 group-hover:opacity-100 transition-opacity">
                            <button type="button"
                                    onclick="openModal(true, @item.CategoryId, '@item.CategoryName', '@item.IconName', '@item.IconUrl')"
                                    class="w-9 h-9 flex items-center justify-center rounded-lg border border-outline-variant hover:bg-surface-container text-on-surface-variant hover:text-primary transition-all">
                                <span class="material-symbols-outlined text-[20px]">edit</span>
                            </button>
                            <form action="/Admin/Categories/Remove/@item.CategoryId"
                                  method="post"
                                  onsubmit="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="w-9 h-9 flex items-center justify-center rounded-lg border border-outline-variant hover:bg-error-container text-on-surface-variant hover:text-error transition-all">
                                    <span class="material-symbols-outlined text-[20px]">delete</span>
                                </button>
                            </form>
                        </div>
                    </div>
                    <h3 class="font-headline-sm text-on-surface">@item.CategoryName</h3>
                    <!-- Etkinlik Sayısı -->
                    <p class="text-sm font-medium text-primary mt-xs">@item.EventCount adet etkinlik</p>
                    <a href="@Url.Action("Index", "Events", new { categoryId = item.CategoryId })"
                       class="block group-hover:underline font-label-md text-on-surface-variant mt-md">
                        Etkinlikleri Gör →
                    </a>
                </div>
            </div>
        }
    </div>
    <!-- Kategori Ekleme/Güncelleme Modalı -->
    <div id="categoryModal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 hidden">
        <div class="bg-white rounded-2xl w-full max-w-md p-lg shadow-xl border border-outline-variant">
            <h2 id="modalTitle" class="font-headline-sm text-on-surface mb-lg">Yeni Kategori Ekle</h2>

            <form id="categoryForm" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="CategoryId" name="CategoryId" />

                <div class="mb-lg">
                    <label class="block font-label-md text-on-surface-variant mb-sm">Kategori Adı</label>
                    <input type="text" id="CategoryName" name="CategoryName" required
                           class="w-full px-md py-2 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 outline-none transition-all" />
                </div>
                <div class="mb-lg">
                    <label class="block font-label-md text-on-surface-variant mb-sm">İkon Adı (örn: piano)</label>
                    <input type="text" id="IconName" name="IconName" required
                           class="w-full px-md py-2 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 outline-none" />
                </div>

                <div class="mb-lg">
                    <label class="block font-label-md text-on-surface-variant mb-sm">Görsel URL</label>
                    <input type="text" id="IconUrl" name="IconUrl" required
                           class="w-full px-md py-2 border border-outline-variant rounded-lg focus:ring-2 focus:ring-primary/20 outline-none" />
                </div>
                <div class="flex justify-end gap-sm">
                    <button type="button" onclick="closeModal()" class="px-lg py-2 text-on-surface-variant font-label-md hover:bg-surface-container rounded-lg">İptal</button>
                    <button type="submit" class="px-lg py-2 bg-primary text-on-primary font-label-md rounded-lg shadow-lg hover:shadow-xl transition-all">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function openModal(isEdit = false, id = null, name = '', icon = '', url = '') {
        const modal = document.getElementById('categoryModal');
        const form = document.getElementById('categoryForm');

        document.getElementById('modalTitle').innerText = isEdit ? 'Kategoriyi Düzenle' : 'Yeni Kategori Ekle';
        form.action = isEdit ? '/Admin/Categories/Update' : '/Admin/Categories/Create';

        document.getElementById('CategoryId').value = id || '';
        document.getElementById('CategoryName').value = name;
        document.getElementById('IconName').value = icon; 
        document.getElementById('IconUrl').value = url;

        modal.classList.remove('hidden');
    }

    function closeModal() {
        document.getElementById('categoryModal').classList.add('hidden');
    }
</script>