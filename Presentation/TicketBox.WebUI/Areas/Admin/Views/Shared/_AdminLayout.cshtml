<!DOCTYPE html>
<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>TicketBox Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <!-- Tailwind Theme Configuration -->
    <script id="tailwind-config">

        tailwind.config = {

        darkMode: "class",

        theme: {

        extend: {

        "colors": {

        "on-tertiary": "#ffffff",

        "on-tertiary-container": "#93e8ff",

        "on-primary-fixed-variant": "#3323cc",

        "surface-tint": "#4d44e3",

        "outline": "#777587",

        "inverse-primary": "#c3c0ff",

        "surface-dim": "#cbdbf5",

        "on-surface-variant": "#464555",

        "surface-container-lowest": "#ffffff",

        "on-primary-container": "#dad7ff",

        "surface-container-low": "#eff4ff",

        "on-tertiary-fixed": "#001f26",

        "tertiary-fixed": "#acedff",

        "tertiary": "#00505f",

        "on-secondary-container": "#fffbff",

        "secondary-fixed-dim": "#ffb1c7",

        "primary": "#3525cd",

        "inverse-surface": "#213145",

        "primary-container": "#4f46e5",

        "surface-variant": "#d3e4fe",

        "secondary-fixed": "#ffd9e2",

        "surface-container": "#e5eeff",

        "secondary": "#b5005d",

        "on-secondary-fixed-variant": "#8e0048",

        "on-background": "#0b1c30",

        "surface-container-highest": "#d3e4fe",

        "tertiary-fixed-dim": "#4cd7f6",

        "on-secondary": "#ffffff",

        "outline-variant": "#c7c4d8",

        "on-secondary-fixed": "#3f001c",

        "secondary-container": "#da2676",

        "on-tertiary-fixed-variant": "#004e5c",

        "on-primary": "#ffffff",

        "surface-bright": "#f8f9ff",

        "error": "#ba1a1a",

        "background": "#f8f9ff",

        "on-surface": "#0b1c30",

        "primary-fixed-dim": "#c3c0ff",

        "primary-fixed": "#e2dfff",

        "on-error-container": "#93000a",

        "tertiary-container": "#006a7c",

        "surface": "#f8f9ff",

        "on-error": "#ffffff",

        "error-container": "#ffdad6",

        "inverse-on-surface": "#eaf1ff",

        "on-primary-fixed": "#0f0069",

        "surface-container-high": "#dce9ff"

        },

        "borderRadius": {

        "DEFAULT": "0.25rem",

        "lg": "0.5rem",

        "xl": "0.75rem",

        "full": "9999px"

        },

        "spacing": {

        "xs": "4px",

        "md": "16px",

        "sm": "8px",

        "xl": "32px",

        "gutter": "24px",

        "container-max": "1280px",

        "lg": "24px",

        "margin-mobile": "16px",

        "base": "4px"

        },

        "fontFamily": {

        "body-lg": ["Inter"],

        "headline-lg": ["Inter"],

        "display-sm": ["Inter"],

        "display-lg": ["Inter"],

        "headline-lg-mobile": ["Inter"],

        "label-sm": ["Inter"],

        "label-md": ["Inter"],

        "body-md": ["Inter"],

        "headline-md": ["Inter"]

        },

        "fontSize": {

        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],

        "headline-lg": ["30px", {"lineHeight": "38px", "fontWeight": "700"}],

        "display-sm": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700"}],

        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "800"}],

        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],

        "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "500"}],

        "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "600"}],

        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],

        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}]

        }

        },

        },

        }

    </script>

    <style>

        body {
        font-family: 'Inter', sans-serif;
        background-color: #f8f9ff;
        }



        .glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        box-shadow: 0px 4px 20px rgba(0, 0, 0, 0.05);
        }



        .sidebar-transition {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }



        .stat-card-hover:hover {
        transform: translateY(-4px);
        box-shadow: 0px 10px 30px rgba(79, 70, 229, 0.08);
        }



        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

    </style>
</head>

<body class="bg-surface text-on-surface">
    <div class="flex flex-col min-h-screen">

        <!-- TopNavBar -->
        <header class="fixed top-0 left-0 w-full z-50 flex justify-between items-center px-lg py-md bg-surface-container-lowest border-b border-outline-variant shadow-sm">
            <span class="text-headline-lg font-black text-primary">TicketBox</span>
            <div class="flex items-center gap-md">
                <button class="bg-primary-container px-md py-sm rounded-lg flex items-center gap-sm">
                    <span class="material-symbols-outlined">auto_awesome</span>
                    Mood Assistant
                </button>
            </div>
        </header>

        <!-- Sidebar ve İçerik -->
        <div class="flex flex-grow pt-20">
            <!-- SideNavBar -->
            <aside class="hidden lg:flex flex-col fixed left-0 top-20 h-[calc(100vh-80px)] w-64 bg-surface border-r border-outline-variant z-40">
                <nav class="flex flex-col gap-sm mt-md px-2">

                    <a class="bg-primary-container text-on-primary-container rounded-xl px-4 py-3 flex items-center gap-md" href="/Admin/AdminDashboard">
                        <span class="material-symbols-outlined">home</span>
                        <span>Dashboard</span>
                    </a>

                    <a class="text-on-surface-variant hover:bg-surface-variant rounded-xl px-4 py-3 flex items-center gap-md transition-colors" href="/Admin/Events">
                        <span class="material-symbols-outlined">event</span>
                        <span>Etkinlikler</span>
                    </a>

                    <a class="text-on-surface-variant hover:bg-surface-variant rounded-xl px-4 py-3 flex items-center gap-md transition-colors" href="/Admin/Categories">
                        <span class="material-symbols-outlined">category</span>
                        <span>Kategoriler</span>
                    </a>

                    <a class="text-on-surface-variant hover:bg-surface-variant rounded-xl px-4 py-3 flex items-center gap-md transition-colors" href="/Admin/Tickets">
                        <span class="material-symbols-outlined">confirmation_number</span>
                        <span>Biletler</span>
                    </a>

                    <a class="text-on-surface-variant hover:bg-surface-variant rounded-xl px-4 py-3 flex items-center gap-md transition-colors" href="/Admin/Users">
                        <span class="material-symbols-outlined">group</span>
                        <span>Kullanıcılar</span>
                    </a>
                </nav>
                <!-- Logout Formu -->
                <form asp-controller="Auth" asp-action="Logout" asp-area="" method="post" class="mt-auto px-2 mb-md">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="text-error hover:bg-error-container rounded-xl px-4 py-3 flex items-center gap-md w-full transition-colors text-left">
                        <span class="material-symbols-outlined">logout</span>
                        <span>Çıkış Yap</span>
                    </button>
                </form>
            </aside>

            <main class="flex-grow lg:ml-64 px-gutter py-xl">
                @RenderBody()
            </main>
        </div>
    </div>
</body>
</html>