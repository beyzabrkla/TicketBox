@model TicketBox.Application.Features.Events.Results.PaginatedEventResult

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Bilet Yönetimi";
}

<div class="max-w-container-max mx-auto p-lg">
    @if (TempData["Success"] != null)
    {
        <div class="mb-lg p-md bg-emerald-100 text-emerald-800 rounded-lg border border-emerald-200">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mb-lg p-md bg-red-100 text-red-800 rounded-lg border border-red-200">
            @TempData["Error"]
        </div>
    }
    <h1 class="font-display-sm text-display-sm mb-lg">Bilet Operasyon Merkezi</h1>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-lg">
        @foreach (var item in Model.Items)
        {
            <div class="bg-white rounded-2xl shadow-ambient border border-outline-variant/30 overflow-hidden">
                <img src="@item.ImageUrl" alt="@item.Title" class="w-full h-40 object-cover" />
                <div class="p-lg">
                    <h2 class="font-title-lg text-on-surface mb-xs">@item.Title</h2>
                    <p class="text-body-sm text-on-surface-variant mb-md">@item.Location • @item.EventDate.ToShortDateString()</p>

                    <!-- Kapasite Barı -->
                    <div class="mb-md">
                        <div class="flex justify-between text-label-sm mb-1">
                            <span>Doluluk</span>
                            <span>@item.TicketCount / @item.Capacity</span>
                        </div>
                        <div class="w-full bg-surface-container-highest rounded-full h-2">
                            <div class="bg-primary h-2 rounded-full" style="width: @((double)item.TicketCount / item.Capacity * 100)%"></div>
                        </div>
                    </div>

                    <!-- Ekleme Formu -->
                    <form asp-area="Admin" asp-controller="Tickets" asp-action="AddTickets" method="post" class="flex gap-sm mb-md">
                        <!-- Hidden input'un doğru gönderildiğinden emin ol -->
                        <input type="hidden" name="eventId" value="@item.EventId" />

                        <input type="number" name="ticketCount" class="w-full px-md py-2 border border-outline-variant rounded-lg" placeholder="Adet" min="1" required />

                        <button type="submit" class="bg-primary text-white px-md py-2 rounded-lg font-label-md hover:bg-primary-dark transition-colors">
                            Ekle
                        </button>
                    </form>

                    <!-- Satılan Biletleri Gör -->
                    <a asp-area="Admin" asp-controller="Tickets" asp-action="SoldTickets" asp-route-eventId="@item.EventId"
                       class="block text-center w-full py-2 border border-primary text-primary rounded-lg font-label-md hover:bg-primary/5">
                        Satılan Biletleri Gör
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- Sayfalama -->
    <div class="mt-xl flex justify-center gap-sm">
        @{
            int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
        }

        @for (int i = 1; i <= totalPages; i++)
        {
            <a asp-action="Index"
               asp-route-page="@i"
               class="px-4 py-2 rounded-lg transition-colors @(Model.PageNumber == i ? "bg-primary text-white" : "bg-white border border-outline-variant hover:bg-surface-container")">
                @i
            </a>
        }
    </div>
</div>