@model IEnumerable<TicketBox.Application.Features.Tickets.Results.GetTicketQueryResult>

@{
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Satılan Biletler";
}

<div class="max-w-container-max mx-auto p-lg">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-lg mb-xl">
        <div>
            <h1 class="font-display-sm text-display-sm text-on-surface tracking-tight">Satılan Biletler</h1>
            <p class="font-body-md text-body-md text-on-surface-variant mt-1">Platform üzerinden satılan tüm biletleri takip edin ve yönetin.</p>
        </div>
        <a asp-action="Index" class="text-primary font-label-md flex items-center gap-xs hover:underline">
            <span class="material-symbols-outlined">arrow_back</span>
            Geri Dön
        </a>
    </div>

    <!-- Table Section -->
    <div class="bg-white rounded-xl shadow-ambient border border-outline-variant/30 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-surface-container-low border-b border-outline-variant">
                    <th class="px-lg py-4 font-label-md text-on-surface-variant">İsim Soyisim</th>
                    <th class="px-lg py-4 font-label-md text-on-surface-variant">E-posta</th>
                    <th class="px-lg py-4 font-label-md text-on-surface-variant">PNR</th>
                    <th class="px-lg py-4 font-label-md text-on-surface-variant">Bilet Kodu</th>
                    <th class="px-lg py-4 font-label-md text-on-surface-variant">Ödenen Tutar</th>
                    <th class="px-lg py-4 font-label-md text-on-surface-variant">Etkinlik</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/30">
                @foreach (var ticket in Model)
                {
                    <tr class="hover:bg-surface-container-low transition-colors">
                        <!-- Mapping profilinde UserName alanına ad-soyadı maplediğimiz için artık böyle kullanabilirsin -->
                        <td class="px-lg py-4 font-body-md text-on-surface">@ticket.UserName</td>

                        <!-- E-posta için AppUser'ın UserName'ine gitmemiz lazım -->
                        <td class="px-lg py-4 font-body-md text-on-surface">@ticket.Booking?.AppUser?.UserName</td>

                        <td class="px-lg py-4 font-mono font-bold text-primary">@ticket.PNR</td>
                        <td class="px-lg py-4 font-mono text-on-surface-variant">@ticket.TicketCode</td>
                        <td class="px-lg py-4 font-body-md text-on-surface">@ticket.Price.ToString("C2")</td>
                        <td class="px-lg py-4 font-body-md text-on-surface">@ticket.Event?.Title</td>
                    </tr>
                }
            </tbody>
        </table>       
        <div class="px-lg py-4 border-t border-outline-variant/30 bg-surface-container-lowest">
            <p class="font-label-sm text-label-sm text-on-surface-variant">@Model?.Count() bilet gösteriliyor</p>
        </div>
    </div>
</div>