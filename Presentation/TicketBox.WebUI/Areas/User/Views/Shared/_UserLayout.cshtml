<!DOCTYPE html>

<html class="light" lang="en">
<head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>@ViewData["Title"] | TicketBox</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
        darkMode: "class",
        theme: {
        extend: {
        "colors": {
        "surface": "#f8f9ff",
        "surface-dim": "#cbdbf5",
        "on-error-container": "#93000a",
        "on-secondary-fixed": "#3f001c",
        "on-secondary": "#ffffff",
        "surface-container-highest": "#d3e4fe",
        "on-tertiary-fixed-variant": "#004e5c",
        "on-primary-container": "#dad7ff",
        "secondary": "#b5005d",
        "surface-tint": "#4d44e3",
        "inverse-on-surface": "#eaf1ff",
        "error": "#ba1a1a",
        "inverse-surface": "#213145",
        "secondary-container": "#da2676",
        "on-error": "#ffffff",
        "on-primary-fixed": "#0f0069",
        "surface-bright": "#f8f9ff",
        "outline-variant": "#c7c4d8",
        "primary-container": "#4f46e5",
        "surface-container-lowest": "#ffffff",
        "surface-container": "#e5eeff",
        "primary-fixed": "#e2dfff",
        "on-surface": "#0b1c30",
        "primary-fixed-dim": "#c3c0ff",
        "surface-container-low": "#eff4ff",
        "tertiary-fixed": "#acedff",
        "on-tertiary-fixed": "#001f26",
        "primary": "#3525cd",
        "surface-container-high": "#dce9ff",
        "outline": "#777587",
        "error-container": "#ffdad6",
        "tertiary-container": "#006a7c",
        "on-surface-variant": "#464555",
        "tertiary": "#00505f",
        "inverse-primary": "#c3c0ff",
        "secondary-fixed": "#ffd9e2",
        "tertiary-fixed-dim": "#4cd7f6",
        "on-primary": "#ffffff",
        "on-tertiary-container": "#93e8ff",
        "on-secondary-fixed-variant": "#8e0048",
        "surface-variant": "#d3e4fe",
        "on-secondary-container": "#fffbff",
        "on-primary-fixed-variant": "#3323cc",
        "background": "#f8f9ff",
        "on-tertiary": "#ffffff",
        "secondary-fixed-dim": "#ffb1c7",
        "on-background": "#0b1c30"
        },
        "borderRadius": {
        "DEFAULT": "0.25rem",
        "lg": "0.5rem",
        "xl": "0.75rem",
        "full": "9999px"
        },
        "spacing": {
        "md": "16px",
        "lg": "24px",
        "sm": "8px",
        "margin-mobile": "16px",
        "container-max": "1280px",
        "xl": "32px",
        "xs": "4px",
        "gutter": "24px",
        "base": "4px"
        },
        "fontFamily": {
        "display-lg": ["Inter"],
        "headline-md": ["Inter"],
        "body-md": ["Inter"],
        "display-sm": ["Inter"],
        "body-lg": ["Inter"],
        "label-md": ["Inter"],
        "headline-lg-mobile": ["Inter"],
        "label-sm": ["Inter"],
        "headline-lg": ["Inter"]
        },
        "fontSize": {
        "display-lg": ["48px", {"lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "800"}],
        "headline-md": ["24px", {"lineHeight": "32px", "fontWeight": "600"}],
        "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
        "display-sm": ["36px", {"lineHeight": "44px", "letterSpacing": "-0.02em", "fontWeight": "700"}],
        "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
        "label-md": ["14px", {"lineHeight": "20px", "letterSpacing": "0.01em", "fontWeight": "600"}],
        "headline-lg-mobile": ["24px", {"lineHeight": "32px", "fontWeight": "700"}],
        "label-sm": ["12px", {"lineHeight": "16px", "fontWeight": "500"}],
        "headline-lg": ["30px", {"lineHeight": "38px", "fontWeight": "700"}]
        }
        },
        },
        }
    </script>
    <style>
        body {
        font-family: 'Inter', sans-serif;
        }

        .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #c7c4d8;
        border-radius: 10px;
        }

        .glass-card {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.3);
        }
    </style>
</head>
<body class="bg-surface text-on-surface overflow-x-hidden">

    <!-- Header -->
    <!-- Header -->
    <header class="fixed top-0 left-0 lg:left-64 w-full lg:w-[calc(100%-16rem)] z-50 bg-surface-container-lowest border-b border-outline-variant shadow-sm transition-all duration-300">
        <div class="flex justify-between items-center px-lg py-md lg:pl-8 lg:pr-12">
            <!-- Logo (sadece mobilde) ve Nav -->
            <div class="flex items-center gap-xl">
                <span class="text-headline-lg font-headline-lg font-black text-primary lg:hidden">TicketBox</span>
                <nav class="hidden md:flex gap-lg items-center">
                    <a class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors" href="#">Konser</a>
                    <a class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors" href="#">Tiyatro</a>
                    <a class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors" href="#">Stand-up</a>
                    <a class="font-label-md text-label-md text-on-surface-variant hover:text-primary transition-colors" href="#">Festival</a>
                </nav>
            </div>

            <!-- Aksiyonlar -->
            <div class="flex items-center gap-md">
                <button class="hidden lg:flex items-center gap-xs px-md py-sm bg-primary-container text-on-primary-container rounded-full font-label-md transition-transform active:scale-95">
                    <span class="material-symbols-outlined text-[20px]">auto_awesome</span>
                    Mod Asistanı
                </button>
                <div class="h-10 w-10 rounded-full bg-surface-container-high flex items-center justify-center overflow-hidden border border-outline-variant">
                    <img class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuACiA7eH8Z3j1nxg5aTrr6QpSRrpPPOhS9J9FeL7LALXgEtMRZH5Sueeswp4MoubCqaLPozxxxZ3vzUB91gofprHPEAdUR7ME048Ks2ke75BlgOOinD6HbHpWaaeI1wNMaVlMv2b7YBPET1aHj5QWrCkOMVXgOIF7HL3L8teYC-KMSvUMOFYVYWnRFrfqEU2gLmg9MS3MuvwfP4RFHUVn0gJkrzbJHtahUrgCL4tgmJVJDF2wowf_Ldm2Qc0NLIsF-rfSLbuwKoVZQ" />
                </div>
            </div>
        </div>
    </header>

    <aside class="hidden lg:flex flex-col h-screen fixed left-0 top-0 w-64 bg-surface border-r border-outline-variant shadow-md z-40">

        <!-- Logo (sidebar'ın üstünde) -->
        <div class="flex items-center justify-center h-20 border-b border-outline-variant">
            <span class="text-headline-lg font-headline-lg font-black text-primary">TicketBox</span>
        </div>

        <nav class="flex-1 flex flex-col gap-1 py-md">
            <a class="flex items-center gap-md mx-2 px-4 py-3 text-on-surface-variant font-label-md hover:bg-surface-container-high rounded-xl transition-transform hover:translate-x-1" href="/Home/Index">
                <span class="material-symbols-outlined">home</span>
                Ana Sayfa
            </a>
            <a class="flex items-center gap-md bg-primary-container text-on-primary-container rounded-xl mx-2 px-4 py-3 font-label-md transition-transform translate-x-1 shadow-sm" href="/UserDashboard/MyTickets">
                <span class="material-symbols-outlined">confirmation_number</span>
                Biletlerim
            </a>
        </nav>

        <div class="p-lg border-t border-outline-variant mt-auto">
            <a href="/Auth/Logout" class="flex items-center gap-md mx-2 px-4 py-3 text-error font-label-md hover:bg-error-container/20 rounded-xl transition-all">
                <span class="material-symbols-outlined">logout</span>
                Çıkış Yap
            </a>
        </div>
    </aside>

    <main class="lg:ml-64 pt-24 min-h-screen bg-surface">
        <div class="max-w-20xl px-6 lg:px-10 py-8">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="w-full py-xl px-lg bg-surface-container-high border-t border-outline-variant mt-20">
        <div class="max-w-container-max mx-auto grid grid-cols-1 md:grid-cols-4 gap-gutter text-center md:text-left">
            <div class="space-y-md">
                <span class="font-headline-md text-headline-md font-bold text-on-surface">TicketBox</span>
                <p class="font-body-md text-body-md text-on-surface-variant">Modern çağın premium etkinlik platformu.</p>
            </div>
            <div class="flex flex-col gap-sm">
                <h4 class="font-label-md text-label-md text-primary uppercase">Hızlı Linkler</h4>
                <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary" href="#">Hakkımızda</a>
                <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary" href="#">Kullanım Koşulları</a>
            </div>
            <div class="flex flex-col gap-sm">
                <h4 class="font-label-md text-label-md text-primary uppercase">Destek</h4>
                <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary" href="#">İletişim</a>
                <a class="font-label-sm text-label-sm text-on-surface-variant hover:text-primary" href="#">SSS</a>
            </div>
            <div class="flex flex-col gap-sm">
                <h4 class="font-label-md text-label-md text-primary uppercase">Bülten</h4>
                <div class="flex">
                    <input class="bg-white border border-outline-variant px-md py-sm rounded-l-lg w-full" placeholder="E-posta" type="email" />
                    <button class="bg-primary text-on-primary px-md py-sm rounded-r-lg font-label-sm hover:opacity-90">Katıl</button>
                </div>
            </div>
        </div>
    </footer>

    <script>
        // Hover ve tıklama etkileri
        document.querySelectorAll('button, a').forEach(el => {
        el.addEventListener('mousedown', () => el.style.transform = 'scale(0.95)');
        el.addEventListener('mouseup', () => el.style.transform = '');
        el.addEventListener('mouseleave', () => el.style.transform = '');
        });

        // Header kaydırma efekti
        window.addEventListener('scroll', () => {
        const header = document.querySelector('header');
        if (window.scrollY > 20) header.classList.add('bg-white/90', 'backdrop-blur-md');
        else header.classList.remove('bg-white/90', 'backdrop-blur-md');
        });
    </script>
</body>
</html>