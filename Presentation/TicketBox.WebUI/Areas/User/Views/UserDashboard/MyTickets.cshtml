@model List<TicketBox.Application.Features.Tickets.Results.GetTicketQueryResult>
@{
    Layout = "~/Areas/User/Views/Shared/_UserLayout.cshtml";
    ViewBag.Title = "Biletlerim";

    var activeTickets = Model?.Where(t => t.IsActive).ToList() ?? new List<TicketBox.Application.Features.Tickets.Results.GetTicketQueryResult>();
    var cancelledTickets = Model?.Where(t => !t.IsActive).ToList() ?? new List<TicketBox.Application.Features.Tickets.Results.GetTicketQueryResult>();
}

<!-- Sayfayı merkeze sabitledik ve üst boşluğu kıstık -->
<div class="max-w-20xl mx-auto px-4 lg:px-6 pt-6 pb-10">

    <!-- Başlık ve Mesajlar -->
    <div class="mb-8">
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 p-4 rounded-xl bg-green-50 text-green-700 border border-green-200 flex items-center gap-3">
                <span class="material-symbols-outlined">check_circle</span> @TempData["Success"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 p-4 rounded-xl bg-red-50 text-error border border-error/20 flex items-center gap-3">
                <span class="material-symbols-outlined">error</span> @TempData["Error"]
            </div>
        }
        <h1 class="text-display-sm font-bold text-on-surface">Biletlerim</h1>
        <p class="text-body-lg text-on-surface-variant mt-2">Yaklaşan ve geçmiş etkinliklerini buradan yönetebilirsin.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

        <!-- ANA İÇERİK (SOL) -->
        <section class="lg:col-span-8 space-y-12">
            <!-- Aktif Biletler -->
            <div>
                <div class="flex items-center justify-between mb-6">
                    <h3 class="text-headline-md font-semibold text-on-surface">Aktif Biletler</h3>
                    <span class="bg-primary/10 text-primary text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider">
                        @activeTickets.Count Yaklaşan
                    </span>
                </div>
                @if (activeTickets.Any())
                {
                    <div class="space-y-6">
                        @foreach (var ticket in activeTickets)
                        {
                            <div class="glass-card flex flex-col md:flex-row overflow-hidden rounded-3xl border border-outline-variant/30 hover:border-primary/50 transition-all duration-300">
                                <div class="relative w-full md:w-64 h-56 md:h-auto shrink-0">
                                    <img src="@ticket.Event?.ImageUrl" class="w-full h-full object-cover" />
                                    <div class="absolute top-4 left-4">
                                        <span class="bg-white/90 backdrop-blur text-primary text-xs font-bold px-3 py-1 rounded-full shadow-sm">
                                            @(ticket.Event?.Category?.CategoryName ?? "Etkinlik")
                                        </span>
                                    </div>
                                </div>
                                <div class="flex-1 p-6 flex flex-col justify-between bg-white/50">
                                    <div>
                                        <h2 class="text-2xl font-bold text-on-surface">@ticket.Event?.Title</h2>
                                        <div class="mt-4 space-y-3">
                                            <div class="flex items-center gap-2 text-on-surface-variant">
                                                <span class="material-symbols-outlined text-[18px]">calendar_today</span>
                                                <span class="text-body-md">@ticket.Event?.EventDate</span>
                                            </div>
                                            <div class="flex items-center gap-2 text-on-surface-variant">
                                                <span class="material-symbols-outlined text-[18px]">location_on</span>
                                                <span class="text-body-md">@ticket.Event?.Location</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mt-6 pt-6 border-t border-outline-variant/20 flex flex-wrap justify-between items-center gap-3">
                                        <span class="font-mono font-bold text-primary bg-primary/5 px-3 py-1 rounded-lg">@ticket.TicketCode</span>
                                        <form action="/User/UserDashboard/RemoveTicket/@ticket.TicketId" method="post" onsubmit="return confirm('Bu bileti iptal etmek istediğinize emin misiniz?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-5 py-2.5 rounded-xl border-2 border-error text-error font-semibold hover:bg-error hover:text-white transition-colors">İptal Et</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Geçmiş Biletler -->
            @if (cancelledTickets.Any())
            {
                <div class="pt-8 border-t border-outline-variant/20">
                    <h3 class="text-headline-md font-semibold text-on-surface mb-6">Geçmiş & İptal Edilenler</h3>
                    <div class="space-y-4">
                        @foreach (var ticket in cancelledTickets)
                        {
                            <div class="flex flex-col md:flex-row overflow-hidden rounded-3xl border border-outline-variant/20 bg-surface-container-low opacity-70 grayscale hover:grayscale-0 transition-all duration-300">
                                <div class="w-full md:w-48 h-32 md:h-auto shrink-0">
                                    <img src="@ticket.Event?.ImageUrl" class="w-full h-full object-cover" />
                                </div>
                                <div class="flex-1 p-6 flex items-center justify-between">
                                    <div>
                                        <h2 class="text-xl font-bold text-on-surface/70 line-through">@ticket.Event?.Title</h2>
                                        <p class="text-error font-bold text-sm mt-1">İptal Edildi</p>
                                    </div>
                                    <span class="text-on-surface-variant/60 font-mono text-sm">@ticket.TicketCode</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>

        <!-- YAN PANEL -->
        <aside class="lg:col-span-4 space-y-6 sticky top-24">
            <div class="bg-primary p-6 rounded-3xl text-on-primary shadow-xl shadow-primary/20 overflow-hidden relative">
                <h3 class="text-headline-md font-bold mb-6">Aktif Mod</h3>
                <div class="flex items-center gap-4 mb-8">
                    <span class="material-symbols-outlined text-3xl">mood</span>
                    <p class="font-bold">Enerjiye Hazır</p>
                </div>
                <button class="w-full bg-white text-primary py-3 rounded-xl font-bold hover:bg-surface-bright transition-colors">
                    Tercihleri Güncelle
                </button>
            </div>

            <div class="bg-white p-6 rounded-3xl border border-outline-variant/30 shadow-sm w-full">
                <h3 class="text-headline-md font-bold text-on-surface mb-6 flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">smart_toy</span>
                    Yapay Zeka
                </h3>

                <div class="space-y-4">
                    <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/20 hover:border-primary/20 transition-colors">
                        <div class="flex items-center gap-4 mb-3">
                            <div class="w-12 h-12 rounded-2xl bg-rose-50 flex items-center justify-center text-rose-600 shrink-0">
                                <span class="material-symbols-outlined">mood</span>
                            </div>
                            <div>
                                <h4 class="font-bold text-sm">Mood-Based Chatbot</h4>
                                <p class="text-xs text-on-surface-variant">Ruh haline uygun öneriler.</p>
                            </div>
                        </div>
                        <button class="w-full py-2.5 bg-slate-900 text-white text-xs font-semibold rounded-xl hover:bg-rose-500 transition-colors">Sohbeti Başlat</button>
                    </div>

                    <div class="bg-surface-container-low p-5 rounded-2xl border border-outline-variant/20 hover:border-primary/20 transition-colors">
                        <div class="flex items-center gap-4 mb-3">
                            <div class="w-12 h-12 rounded-2xl bg-cyan-50 flex items-center justify-center text-cyan-600 shrink-0">
                                <span class="material-symbols-outlined">analytics</span>
                            </div>
                            <div>
                                <h4 class="font-bold text-sm">Tabili AI</h4>
                                <p class="text-xs text-on-surface-variant">Veri analitiği sorgula.</p>
                            </div>
                        </div>
                        <div class="bg-slate-900 rounded-xl p-3 font-mono text-[10px] text-cyan-400 mb-3 overflow-hidden">
                            > SELECT * FROM insights...
                        </div>
                        <button class="w-full py-2.5 bg-cyan-600 text-white text-xs font-semibold rounded-xl hover:bg-cyan-700 transition-colors">Analiz Et</button>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>