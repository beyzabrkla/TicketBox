@{
    ViewData["Title"] = "Etkinlik Detay";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Hero Section -->
<section class="relative w-full h-[650px] overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style="background-image: url('https://lh3.googleusercontent.com/aida-public/AB6AXuBn6y8uw4DokBEwekF53skYWlXGT65Lnfd7paGGQkU7J0vArVNNWtkDEKUgetMxCvidWEw5AKyOHhHTYnDck9o8IZPsIIMCuaHQgd_3Zw01bjms-ikNgD6nVpi9l_pP1k4mPy4ZtiZkZk1_iaFhRVKHOvW75v-ibkbpq82-ow7LcKqhsheb7LfGqbv4e901v8Rxih3S6MWT4Xq--vWaxSJ3OvxmjvbvmU5mTKk4I3Nmw5Bopl4QBbzXBxo_MsjX5BCetJqNNTuGXhI')"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent"></div>
    <div class="relative h-full max-w-container-max mx-auto px-lg flex flex-col justify-end pb-32">
        <div class="flex flex-col gap-md max-w-3xl">
            <div class="flex items-center gap-sm">
                <span class="bg-secondary-container text-on-secondary-container px-md py-1 rounded-full font-label-sm uppercase tracking-wider">En Popüler</span>
                <span class="bg-tertiary-container text-on-tertiary-container px-md py-1 rounded-full font-label-sm uppercase tracking-wider">Müzik</span>
            </div>
            <h1 class="font-display-lg text-display-lg text-on-surface drop-shadow-xl leading-tight">Midnight Echoes: Live at Zenith Pavilion</h1>
            <div class="flex flex-wrap items-center gap-xl text-on-surface-variant font-body-md mt-lg">
                <div class="flex items-center gap-base">
                    <span class="material-symbols-outlined text-primary">calendar_month</span>
                    <span>15 Temmuz 2026</span>
                </div>
                <div class="flex items-center gap-base">
                    <span class="material-symbols-outlined text-primary">location_on</span>
                    <span>Zenith Outdoor Pavilion, Los Angeles</span>
                </div>
                <div class="flex items-center gap-base">
                    <span class="material-symbols-outlined text-primary">schedule</span>
                    <span>20:00 (Kapı Açılış: 18:30)</span>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- Main Content -->
<div class="max-w-container-max mx-auto px-lg grid grid-cols-1 lg:grid-cols-12 gap-16 -mt-20 relative z-10">
    <!-- Left Column: Details -->
    <div class="lg:col-span-8 flex flex-col gap-12">
        <!-- About Card -->
        <div class="glass-card p-12 rounded-xl shadow-lg border border-outline-variant/30 flex flex-col gap-10">
            <div class="flex flex-col gap-lg">
                <h2 class="font-headline-md text-headline-md text-on-surface border-l-4 border-primary pl-4">Etkinlik Hakkında</h2>
                <p class="text-body-lg text-on-surface-variant leading-relaxed">
                    Midnight Echoes, "Synthetic Dreams" dünya turnesini Zenith Pavilion'a taşıyarak sizi büyüleyici bir ses dünyasına ve görsel hikaye anlatımına davet ediyor. Neo-soul ve yüksek enerjili synth-pop'un eşsiz karışımıyla tanınan grup, bu performans için özel olarak tasarlanmış 360 derecelik bir ses ortamı ve etkileyici projeksiyon haritalama teknikleri sunuyor.
                </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-lg">
                <div class="flex gap-md p-lg bg-surface-container-low/50 rounded-xl border border-outline-variant/30">
                    <span class="material-symbols-outlined text-primary text-3xl shrink-0">info</span>
                    <div>
                        <p class="font-label-md text-on-surface mb-sm">Bilet Kuralları</p>
                        <ul class="text-label-sm text-on-surface-variant list-disc pl-md space-y-1">
                            <li>Yalnızca dijital bilet</li>
                            <li>48 saat öncesine kadar iade imkanı</li>
                            <li>Profesyonel kamera yasaktır</li>
                        </ul>
                    </div>
                </div>
                <div class="flex gap-md p-lg bg-surface-container-low/50 rounded-xl border border-outline-variant/30">
                    <span class="material-symbols-outlined text-secondary text-3xl shrink-0">local_parking</span>
                    <div>
                        <p class="font-label-md text-on-surface mb-sm">Ulaşım ve Otopark</p>
                        <p class="text-label-sm text-on-surface-variant">Vadi vale ve genel otopark mevcuttur. Toplu taşıma kullanımı şiddetle tavsiye edilir.</p>
                    </div>
                </div>
            </div>
        </div>
        <!-- Artist Card -->
        <div class="bg-surface-container-lowest p-12 rounded-xl shadow-md border border-outline-variant">
            <h2 class="font-headline-md text-headline-md text-on-surface mb-10 border-l-4 border-primary pl-4">Sanatçılar</h2>
            <div class="flex flex-col md:flex-row gap-lg items-center">
                <div class="w-40 h-40 rounded-full border-4 border-primary-container overflow-hidden shrink-0 shadow-lg">
                    <img alt="Midnight Echoes Artist" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCAPzg03lcnMOPwizjTBzu1BkR1DKjKBUny029PB2rk4uUV2y6heFuGtInKw8XjCCX8GN3VvpVuEeb4Hf4xdZC-MxodTMdVuYoS--vWkH0K2UI6vbqg02DKF42LhfloHkN3l-NBIuPSJaWa8Bxcgh_3LfCErEsgJK-8CG2T0hNIEU2CC_29QaVdEs4wd3laeuAIw9CwvN1A8NL0IfNJM6lmUbpdmYhDcmrpeuzFALGIUzJZerHkUK4_L8Ptm9j9PtUrCsS_SAtczUk" />
                </div>
                <div class="flex-grow text-center md:text-left">
                    <h3 class="font-headline-md text-headline-md text-primary">Midnight Echoes</h3>
                    <p class="text-label-md text-secondary uppercase font-bold mt-1 mb-md">Ana Sanatçı</p>
                    <p class="text-body-md text-on-surface-variant italic leading-relaxed">"Modern görsel-işitsel performans sanatında devrim niteliğinde bir güç." — Global Sound Weekly</p>
                    <div class="flex gap-sm mt-lg justify-center md:justify-start">
                        <span class="px-md py-base bg-surface-container-high rounded-full text-label-sm text-on-surface font-medium">Indie Pop</span>
                        <span class="px-md py-base bg-surface-container-high rounded-full text-label-sm text-on-surface font-medium">Synth Wave</span>
                    </div>
                </div>
            </div>
        </div>
        <!-- Location Map -->
        <div class="bg-surface-container-lowest p-12 rounded-xl shadow-md border border-outline-variant">
            <h2 class="font-headline-md text-headline-md text-on-surface mb-lg border-l-4 border-primary pl-4">Etkinlik Yeri</h2>
            <div class="w-full h-64 bg-surface-container rounded-lg border border-outline-variant relative overflow-hidden group">
                <img alt="Map Location" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAfUj6hAl7jTvBSSVxdRX1Jgr87NyfauiHfMdxlYZRTS3SSQngwuiM8AmszMmQj7ka1NBkfKMsnzhtsYKCgLZrq00UWcYZrBgumeT5ORMw1GdWgmjrHDLSwY4M4YdC5S_ZTW8nyFTnSgSjXNvSKZukGFmF-9Brc__sPMiis_DZombMzH5jScUdha-kgUO3uVkYkNnQRzfrcpm4EGa08wO3vCcGnLhA5yxIsitVDJ6ZKjgScsGYmoB_7ZF2Ey4F9XYshru3M4to3qdo" />
                <div class="absolute inset-0 bg-primary/5 pointer-events-none"></div>
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                    <span class="material-symbols-outlined text-secondary text-5xl drop-shadow-md" style="font-variation-settings: 'FILL' 1;">location_on</span>
                </div>
            </div>
            <div class="mt-lg flex justify-between items-end">
                <div>
                    <p class="font-headline-md text-on-surface">Zenith Outdoor Pavilion</p>
                    <p class="text-body-md text-on-surface-variant mt-1">4200 Grand Ave, Los Angeles, CA 90012</p>
                </div>
                <button class="text-primary font-label-md flex items-center gap-xs hover:underline transition-all">
                    Haritalarda Aç <span class="material-symbols-outlined text-sm">north_east</span>
                </button>
            </div>
        </div>
    </div>
    <!-- Right Column: Ticket Card -->
    <div class="lg:col-span-4 flex flex-col gap-12">
        <!-- Pricing Sticky Widget -->
        <div class="glass-card p-10 rounded-xl shadow-2xl border-2 border-primary/20 flex flex-col gap-10">
            <div class="flex justify-between items-start">
                <div>
                    <p class="text-label-sm text-on-surface-variant uppercase font-bold tracking-widest mb-1">BİLET FİYATI</p>
                    <h3 class="font-display-sm text-display-sm text-primary">2.850 TL</h3>
                </div>
                <div class="text-right">
                    <p class="text-label-sm text-on-surface-variant uppercase font-bold tracking-widest mb-1">KALAN</p>
                    <p class="text-headline-md text-secondary">42 Koltuk</p>
                </div>
            </div>
            <div class="flex flex-col gap-md">
                <div class="flex justify-between items-center p-md bg-surface-container-low rounded-lg border border-outline-variant">
                    <p class="font-label-md text-on-surface">Adet</p>
                    <div class="flex items-center gap-lg">
                        <button class="w-10 h-10 rounded-full border border-primary text-primary flex items-center justify-center hover:bg-primary hover:text-on-primary transition-all shadow-sm" id="minus-btn">
                            <span class="material-symbols-outlined">remove</span>
                        </button>
                        <span class="font-headline-md text-on-surface w-6 text-center" id="ticket-count">2</span>
                        <button class="w-10 h-10 rounded-full border border-primary text-primary flex items-center justify-center hover:bg-primary hover:text-on-primary transition-all shadow-sm" id="plus-btn">
                            <span class="material-symbols-outlined">add</span>
                        </button>
                    </div>
                </div>
                <div class="flex flex-col gap-sm border-t border-outline-variant pt-lg mt-md">
                    <div class="flex justify-between text-body-md text-on-surface-variant">
                        <span>Ara Toplam (2 bilet)</span>
                        <span>5.700 TL</span>
                    </div>
                    <div class="flex justify-between text-body-md text-on-surface-variant">
                        <span>Hizmet Bedeli</span>
                        <span>150 TL</span>
                    </div>
                    <div class="flex justify-between font-headline-md text-headline-md text-on-surface pt-sm mt-base border-t border-outline-variant/30">
                        <span>Toplam</span>
                        <span>5.850 TL</span>
                    </div>
                </div>
                <button class="w-full py-5 bg-primary text-on-primary rounded-xl font-headline-md shadow-lg hover:shadow-primary/40 hover:-translate-y-0.5 transition-all flex items-center justify-center gap-md mt-lg">
                    <span class="material-symbols-outlined">shopping_cart</span>
                    Bilet Satın Al
                </button>
                <p class="text-label-sm text-center text-on-surface-variant flex items-center justify-center gap-1 mt-md">
                    <span class="material-symbols-outlined text-sm">lock</span> Güvenli ödeme - TicketBox Enterprise
                </p>
            </div>
        </div>
        <!-- Mood Assistant Integrated -->
        <div class="bg-gradient-to-br from-primary ... p-10 rounded-xl shadow-xl flex flex-col gap-lg">
            <div class="flex items-center gap-md">
                <div class="p-sm bg-white/20 rounded-lg backdrop-blur-md">
                    <span class="material-symbols-outlined text-3xl" style="font-variation-settings: 'FILL' 1;">auto_awesome</span>
                </div>
                <div>
                    <h4 class="font-headline-md text-headline-md">Mood Asistanı</h4>
                    <p class="text-label-sm opacity-80">Kişiselleştirilmiş kürasyon</p>
                </div>
            </div>
            <p class="text-body-md italic leading-relaxed">"Bu konserin ruh halinize uygun olup olmadığını öğrenmek için bana nasıl hissettiğinizi söyleyin."</p>
            <div class="relative mt-md">
                <input class="w-full bg-white/10 border border-white/20 rounded-lg px-md py-4 text-white placeholder:text-white/60 focus:ring-2 focus:ring-secondary outline-none transition-all" placeholder="Enerjik hissediyorum..." type="text" />
                <button class="absolute right-3 top-1/2 -translate-y-1/2 p-2 hover:bg-white/20 rounded-md">
                    <span class="material-symbols-outlined">send</span>
                </button>
            </div>
        </div>
    </div>
</div>