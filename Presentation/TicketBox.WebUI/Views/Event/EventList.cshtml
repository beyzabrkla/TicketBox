@model TicketBox.Application.Features.Events.ViewModels.EventListViewModel
@using Microsoft.AspNetCore.Http

<section class="relative py-20 flex flex-col items-center justify-center min-h-[400px] overflow-hidden rounded-3xl mt-6">
    <div class="absolute inset-0 z-0">
        <img class="w-full h-full object-cover brightness-50" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBMuqimu8YgiTlkQSRKjm6VIalF1ONckyGNO4zCIzyciJndL5AHQw62rxtJH-of_PIAO8w5Uo1MgckCnMYe5ffXhnxXfhIUUGdoXA_RnM5A9tORUumFokrmepzp0ulDrEW_3n98fNu86WbEL4vblCZxJ2F6LOgm_BPthmPFTpG3D6xm79OYicHAoofZVL8e7HXxk14VHx-HuYm5mYMIS_FHs-Gi-3wI_pS9xAmpvQVrZF77M-8alFr9Wj5iUyObspF4Tk0JiItly10" />
    </div>
    <div class="relative z-10 w-full max-w-2xl px-6">
        <h1 class="text-5xl font-bold text-white text-center mb-10">Sıradaki Deneyimini Bul</h1>
        <form asp-action="EventList" method="get" class="bg-white/90 backdrop-blur p-2 rounded-full flex shadow-2xl">
            <div class="flex-grow flex items-center px-6">
                <span class="material-symbols-outlined text-gray-500">search</span>
                <input name="search" class="bg-transparent border-none focus:ring-0 w-full px-4 text-gray-900" placeholder="Sanatçı, etkinlik veya mekan ara..." type="text" />
            </div>
            <button type="submit" class="bg-indigo-600 text-white px-8 py-3 rounded-full hover:bg-indigo-700 transition-all">Ara</button>
        </form>
    </div>
</section>

<!-- İçerik -->
<div class="max-w-7xl mx-auto px-4 py-12 flex flex-col lg:flex-row gap-12">

    <!-- Filtreler -->
    <aside class="w-full lg:w-72 shrink-0">
        <form asp-action="EventList" method="get" class="bg-gray-50 p-6 rounded-2xl border border-gray-100">
            <h3 class="text-xl font-bold mb-6">Filtreler</h3>

            <input type="hidden" name="search" value="@Context.Request.Query["search"]" />

            <div class="space-y-3 mb-8">
                <h4 class="font-semibold text-gray-800">Kategoriler</h4>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in (IEnumerable<TicketBox.Application.Features.Categories.Results.GetCategoryQueryResult>)ViewBag.Categories)
                    {
                        var isChecked = Context.Request.Query["categoryId"] == cat.CategoryId.ToString() ? "checked" : "";
                        <label class="flex items-center space-x-3 cursor-pointer">
                            <input type="radio" name="categoryId" value="@cat.CategoryId" @isChecked
                                   class="w-5 h-5 rounded-full border-gray-300 text-indigo-600 focus:ring-indigo-500" />
                            <span class="text-gray-700">@cat.CategoryName</span>
                        </label>
                    }
                }
            </div>

            <div class="mb-8">
                @{
                    // Sayfa yenilendiğinde URL'deki değeri yakala, yoksa varsayılan 5000 olsun
                    var priceValue = Context.Request.Query["maxPrice"].ToString();
                    var displayPrice = !string.IsNullOrEmpty(priceValue) ? priceValue : "5000";
                }
                <span class="text-xs font-bold text-gray-500 uppercase tracking-widest block mb-4">
                    Fiyat Aralığı: <b id="price-val" class="text-indigo-600">@displayPrice</b> TL
                </span>
                <input name="maxPrice" type="range" min="0" max="5000"
                       value="@displayPrice"
                       oninput="document.getElementById('price-val').innerText = this.value"
                       class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-indigo-600" />
            </div>

            <button type="submit" class="w-full bg-indigo-600 text-white py-3 rounded-xl font-bold hover:bg-indigo-700 transition-all">Filtrele</button>

            <!-- Filtreleri Temizle Butonu -->
            <a href="@Url.Action("EventList", "Event")"
               class="block w-full text-center mt-4 py-2 text-sm text-gray-500 hover:text-indigo-600 hover:underline transition-all">
                Filtreleri Temizle
            </a>
        </form>
    </aside>
    
    <!-- Etkinlikler Listesi (Grid Yapısı) -->
        <div class="flex-grow">
        <!-- Güncellenmiş Modern Etkinlik Kartları -->
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-8">
            @if (Model.Events != null && Model.Events.Any())
            {
                foreach (var item in Model.Events)
                {
                    <div class="group bg-white rounded-3xl border border-gray-100 shadow-[0_4px_20px_rgba(0,0,0,0.05)] hover:shadow-[0_20px_40px_rgba(0,0,0,0.1)] transition-all duration-300 overflow-hidden flex flex-col hover:-translate-y-2">
                        <!-- Görsel Alanı -->
                        <div class="relative h-56 overflow-hidden">
                            <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="@item.ImageUrl" alt="@item.Title" />
                            <!-- Fiyat Etiketi (Modern bir badge) -->
                            <div class="absolute top-4 right-4 bg-white/90 backdrop-blur px-3 py-1 rounded-full font-bold text-indigo-600 shadow-sm">
                                @item.Price.ToString("N0") TL
                            </div>
                        </div>

                        <div class="p-6 flex flex-col flex-grow">
                            <!-- Kategori ve Mekan Bilgisi -->
                            <div class="flex items-center gap-2 mb-3">
                                <span class="text-[10px] uppercase tracking-widest font-bold text-indigo-600 bg-indigo-50 px-2 py-1 rounded-md">@item.CategoryName</span>
                                <span class="text-xs text-gray-400 font-medium">@item.Location</span>
                            </div>

                            <h3 class="text-xl font-bold mb-2 text-gray-900 line-clamp-2">@item.Title</h3>
                            <p class="text-sm text-gray-500 mb-6 flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm">calendar_today</span>
                                @item.EventDate.ToString("dd MMMM, HH:mm")
                            </p>

                            <!-- Aksiyon Butonu -->
                            <a asp-action="EventDetail" asp-route-id="@item.EventId"
                               class="mt-auto w-full py-3 rounded-2xl bg-gray-900 text-white font-bold hover:bg-indigo-600 transition-colors text-center shadow-lg hover:shadow-indigo-500/20">
                                Bilet Al
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-span-full text-center py-24 bg-gray-50 rounded-3xl border border-dashed border-gray-200">
                    <span class="material-symbols-outlined text-5xl text-gray-300 mb-4">search_off</span>
                    <p class="text-gray-500 font-medium">Bu kriterlerde etkinlik bulunamadı.</p>
                </div>
            }
        </div>
            <!-- Sayfalama -->
        <nav class="flex items-center gap-2 mt-12 justify-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <a href="@Url.Action("EventList", "Event", new
                   {
                       search = Context.Request.Query["search"],
                       categoryId = Context.Request.Query["categoryId"],
                       maxPrice = Context.Request.Query["maxPrice"],
                       pageNumber = i
                   })"
                   class="@(i == Model.PageNumber ? "bg-indigo-600 text-white" : "border") px-4 py-2 rounded-lg">
                    @i
                </a>
            }
        </nav>
        </div>
</div>

<script>
        function goToPage(page) {
        let url = new URL(window.location.href);
        url.searchParams.set('pageNumber', page); // Sadece sayfa numarasını değiştirir, diğerlerini korur
        window.location.href = url.toString();
    }
</script>