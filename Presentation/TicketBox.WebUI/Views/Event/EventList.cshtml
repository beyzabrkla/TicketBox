                </div>
                <div class="p-lg flex flex-col flex-grow">
                    <h3 class="font-headline-md text-headline-md mb-xs">Gece Yarısı Jazz</h3>
                    <div class="flex items-center text-on-surface-variant font-label-md mb-sm">
                        <span class="material-symbols-outlined text-sm mr-xs">calendar_today</span>
                        14 Ekim, 21:00
                    </div>
                    <div class="flex items-center text-on-surface-variant font-label-md mb-md">
                        <span class="material-symbols-outlined text-sm mr-xs">location_on</span>
                        Babylon İstanbul
                    </div>
                    <div class="mt-auto ticket-punch border-t border-dashed border-outline-variant/50 pt-lg flex items-center justify-between">
                        <div class="font-headline-md text-primary">450 TL</div>
                        <button class="bg-primary-container text-on-primary px-lg py-sm rounded-lg font-label-md hover:bg-primary transition-colors">Bilet Al</button>
