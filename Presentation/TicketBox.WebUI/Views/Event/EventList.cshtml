@{
    ViewData["Title"] = "Etkinlikler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="relative py-xxl flex flex-col items-center justify-center min-h-[400px] overflow-hidden rounded-xl mt-md">
    <div class="absolute inset-0 z-0">
        <img class="w-full h-full object-cover brightness-50" data-alt="A high-energy concert scene with vibrant stage lighting and a massive crowd in a modern arena. The atmosphere is electric with deep blues and purples, reflecting a premium entertainment platform. Soft ambient glow illuminates the surroundings, creating a sense of excitement and high-production value for a professional event listing page." src="https://lh3.googleusercontent.com/aida-public/AB6AXuBMuqimu8YgiTlkQSRKjm6VIalF1ONckyGNO4zCIzyciJndL5AHQw62rxtJH-of_PIAO8w5Uo1MgckCnMYe5ffXhnxXfhIUUGdoXA_RnM5A9tORUumFokrmepzp0ulDrEW_3n98fNu86WbEL4vblCZxJ2F6LOgm_BPthmPFTpG3D6xm79OYicHAoofZVL8e7HXxk14VHx-HuYm5mYMIS_FHs-Gi-3wI_pS9xAmpvQVrZF77M-8alFr9Wj5iUyObspF4Tk0JiItly10" />
    </div>
    <div class="relative z-10 w-full max-w-3xl px-md">
        <h1 class="font-display-lg text-display-lg text-white text-center mb-xl">Sıradaki Deneyimini Bul</h1>
        <div class="glass-card p-sm rounded-full flex items-center shadow-2xl">
            <div class="flex-grow flex items-center px-md">
                <span class="material-symbols-outlined text-on-surface-variant">search</span>
                <input class="bg-transparent border-none focus:ring-0 w-full px-sm font-body-md text-on-surface placeholder:text-on-surface-variant" placeholder="Sanatçı, etkinlik veya mekan ara..." type="text" />
            </div>
            <div class="h-8 w-[1px] bg-outline-variant/30 hidden md:block"></div>
            <div class="hidden md:flex items-center px-md cursor-pointer">
                <span class="material-symbols-outlined text-on-surface-variant mr-xs">location_on</span>
                <span class="font-label-md text-on-surface whitespace-nowrap">Tüm Türkiye</span>
            </div>
            <button class="bg-primary-container text-on-primary font-label-md px-xl py-md rounded-full hover:bg-primary transition-all">
                Ara
            </button>
        </div>
    </div>
</section>
<!-- Content Area: Filters + Grid -->
<div class="flex flex-col lg:flex-row gap-xl py-xl max-w-container-max mx-auto px-md">
    <!-- Filters Sidebar -->
    <aside class="w-full lg:w-72 shrink-0 space-y-xl">
        <div class="bg-surface-container-low p-lg rounded-xl border border-outline-variant/30">
            <h3 class="font-headline-md text-headline-md mb-md">Filtreler</h3>
            <!-- Categories -->
            <div class="mb-xl">
                <span class="font-label-md text-on-surface-variant uppercase tracking-wider block mb-sm">Kategori</span>
                <div class="space-y-sm">
                    <label class="flex items-center space-x-sm cursor-pointer group">
                        <input checked="" class="w-5 h-5 rounded border-outline-variant text-primary focus:ring-primary" type="checkbox" />
                        <span class="font-body-md text-on-surface group-hover:text-primary transition-colors">Konser</span>
                    </label>
                    <label class="flex items-center space-x-sm cursor-pointer group">
                        <input class="w-5 h-5 rounded border-outline-variant text-primary focus:ring-primary" type="checkbox" />
                        <span class="font-body-md text-on-surface group-hover:text-primary transition-colors">Tiyatro</span>
                    </label>
                    <label class="flex items-center space-x-sm cursor-pointer group">
                        <input class="w-5 h-5 rounded border-outline-variant text-primary focus:ring-primary" type="checkbox" />
                        <span class="font-body-md text-on-surface group-hover:text-primary transition-colors">Stand-up</span>
                    </label>
                    <label class="flex items-center space-x-sm cursor-pointer group">
                        <input class="w-5 h-5 rounded border-outline-variant text-primary focus:ring-primary" type="checkbox" />
                        <span class="font-body-md text-on-surface group-hover:text-primary transition-colors">Festival</span>
                    </label>
                </div>
            </div>
            <!-- Price Range -->
            <div class="mb-xl">
                <span class="font-label-md text-on-surface-variant uppercase tracking-wider block mb-sm">Fiyat Aralığı</span>
                <input class="w-full h-2 bg-outline-variant rounded-lg appearance-none cursor-pointer accent-primary" type="range" />
                <div class="flex justify-between mt-xs font-label-sm text-on-surface-variant">
                    <span>0 TL</span>
                    <span>5000+ TL</span>
                </div>
            </div>
            <!-- Date Filter -->
            <div class="mb-md">
                <span class="font-label-md text-on-surface-variant uppercase tracking-wider block mb-sm">Tarih</span>
                <input class="w-full bg-surface border border-outline-variant rounded-lg px-md py-sm font-body-md focus:ring-2 focus:ring-primary/20" type="date" />
            </div>
        </div>
        <!-- Promo Card -->
        <div class="bg-secondary-container p-lg rounded-xl text-on-primary">
            <span class="material-symbols-outlined mb-sm">confirmation_number</span>
            <h4 class="font-headline-md text-headline-md leading-tight mb-xs">Bültene Katıl</h4>
            <p class="font-body-md opacity-90 mb-md">Yeni etkinliklerden ilk sen haberdar ol.</p>
            <button class="w-full bg-white text-secondary font-label-md py-sm rounded-lg hover:bg-opacity-90 transition-all">Kaydol</button>
        </div>
    </aside>
    <!-- Event Bento Grid -->
    <div class="flex-grow">
        <div class="flex items-center justify-between mb-xl">
            <h2 class="font-headline-lg text-headline-lg">Popüler Etkinlikler</h2>
            <div class="flex items-center space-x-md font-label-md text-on-surface-variant">
                <span>Sırala:</span>
                <select class="bg-transparent border-none focus:ring-0 text-on-surface font-label-md cursor-pointer">
                    <option>En Yeni</option>
                    <option>Fiyat: Düşükten Yükseğe</option>
                    <option>Tarih: Yakın</option>
                </select>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-lg">
