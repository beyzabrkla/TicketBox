@model List<TicketBox.Application.Features.Categories.Results.GetCategoryQueryResult>

<section class="py-2xl bg-surface-container-low/50">
    <div class="max-w-container-max mx-auto px-lg">
        <div class="flex flex-col lg:flex-row items-center justify-between gap-xl mb-2xl mb-xl">
            <div class="max-w-md">
                <h2 class="font-headline-lg text-headline-lg text-on-surface mb-sm">Kategorilere Göre Keşfet</h2>
                <p class="text-body-md text-on-surface-variant">Her zevke uygun yüzlerce etkinlik seni bekliyor.</p>
            </div>
            <div class="flex flex-wrap justify-center gap-md">
                <button class="flex items-center gap-xs px-lg py-sm rounded-full bg-primary text-on-primary font-label-md transition-all shadow-md">
                    <span class="material-symbols-outlined text-[20px]">piano</span> Konser
                </button>
                <button class="flex items-center gap-xs px-lg py-sm rounded-full bg-white text-on-surface-variant font-label-md hover:bg-surface-container transition-all border border-outline-variant">
                    <span class="material-symbols-outlined text-[20px]">theater_comedy</span> Tiyatro
                </button>
                <button class="flex items-center gap-xs px-lg py-sm rounded-full bg-white text-on-surface-variant font-label-md hover:bg-surface-container transition-all border border-outline-variant">
                    <span class="material-symbols-outlined text-[20px]">sports_soccer</span> Spor
                </button>
                <button class="flex items-center gap-xs px-lg py-sm rounded-full bg-white text-on-surface-variant font-label-md hover:bg-surface-container transition-all border border-outline-variant">
                    <span class="material-symbols-outlined text-[20px]">mic</span> Stand-up
                </button>
            </div>
        </div>
        <div class="bento-grid">
            @for (int i = 0; i < Model.Count; i++)
            {
                var item = Model[i];
                <!-- i == 0 ise büyük kutu sınıfını ekle -->
                <div class="relative rounded-3xl overflow-hidden group shadow-lg @(i == 0 ? "bento-item-large" : "")">

                    <img class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                         src="@item.IconUrl" alt="@item.CategoryName">

                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>

                    <div class="absolute bottom-0 left-0 p-lg text-white w-full">
                        <span class="material-symbols-outlined text-[32px] mb-xs block">@item.IconName</span>
                        <h4 class="font-headline-sm text-headline-sm">@item.CategoryName</h4>
                    </div>
                </div>
            }
        </div>
    </div>
</section>