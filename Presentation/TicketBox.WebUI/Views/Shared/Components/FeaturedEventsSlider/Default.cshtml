@model List<TicketBox.Application.Features.Events.Results.EventResult>
<section class="py-2xl relative">
    <div class="absolute inset-0 bg-gradient-to-b from-[#f8f9ff] via-white to-[#f8f9ff] pointer-events-none"></div>
    <div class="max-w-container-max mx-auto px-lg relative z-10">
        <div class="flex justify-between items-end mb-xl">
            <div>
                <h2 class="font-headline-lg text-headline-lg text-on-surface">Popüler Etkinlikler</h2>
                <p class="text-body-md text-on-surface-variant">Tükenmeden yerini ayırt</p>
            </div>
            <div class="flex gap-sm">
                <button class="p-md rounded-full border border-outline-variant bg-white shadow-sm hover:shadow-md hover:border-primary transition-all">
                    <span class="material-symbols-outlined">chevron_left</span>
                </button>
                <button class="p-md rounded-full border border-outline-variant bg-white shadow-sm hover:shadow-md hover:border-primary transition-all">
                    <span class="material-symbols-outlined">chevron_right</span>
                </button>
            </div>
        </div>
        <div class="flex gap-lg overflow-x-auto pb-xl custom-scrollbar snap-x scroll-pl-6">
            @foreach (var item in Model)
            {
                <div class="min-w-[340px] md:min-w-[440px] snap-start group bg-white rounded-2xl overflow-hidden border border-outline-variant/50 hover:border-primary/30 transition-all shadow-sm hover:shadow-xl">
                    <div class="relative h-64 overflow-hidden">
                        <img class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110" src="@item.ImageUrl" alt="@item.Title">

                        @if (item.IsFastSelling)
                        {
                            <div class="absolute top-md right-md bg-secondary text-on-secondary px-md py-1 rounded-full font-label-md text-label-md">Hızla Tükeniyor</div>
                        }
                    </div>
                    <div class="p-lg">
                        <div class="flex justify-between items-center mb-sm">
                            <span class="font-label-sm text-label-sm text-primary font-bold uppercase tracking-wide">@item.CategoryName</span>
                            <span class="font-label-md text-label-md text-primary-container font-bold">@item.Price TL'den</span>
                        </div>
                        <h3 class="font-headline-md text-headline-md text-on-surface mb-sm group-hover:text-primary transition-colors">@item.Title</h3>
                        <div class="flex items-center gap-xs text-on-surface-variant text-label-md">
                            <span class="material-symbols-outlined text-[18px]">location_on</span>
                            @item.Location
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>